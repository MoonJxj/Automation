<Project Sdk="Microsoft.NET.Sdk">

  <!--
    新框架的测试项目。与旧 EquipmentMonitor.*.Tests 分开：
    旧测试引用的是迁移中断的旧模块，无法作为新框架的回归基线。
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EquipmentMonitor.Common\EquipmentMonitor.Common.csproj" />
    <ProjectReference Include="..\..\src\EquipmentMonitor.Core\EquipmentMonitor.Core.csproj" />
    <ProjectReference Include="..\..\src\EquipmentMonitor.Infrastructure\EquipmentMonitor.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="FluentAssertions" />
  </ItemGroup>

  <ItemGroup>
    <!-- 默认配置文件随测试输出，用于验证 AxisFrameworkBootstrapper 的无参入口。 -->
    <None Include="..\..\src\EquipmentMonitor.Infrastructure\Configuration\axis-framework.json"
          Link="axis-framework.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>