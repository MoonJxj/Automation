<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- 继续把警告当错误，防止其他严重问题被放过。 -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- 但空引用系列只警告，不报错。 -->
    <WarningsNotAsErrors>CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8619;CS8625</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NModbus" />
    <PackageReference Include="NModbus.Serial" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="SqlSugarCore" />
    <!-- Microsoft.Extensions.Options：MIT；报警服务用 IOptions<AlarmOptions>，版本见 Directory.Packages.props。 -->
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="System.IO.Ports" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EquipmentMonitor.Common\EquipmentMonitor.Common.csproj" />
    <ProjectReference Include="..\EquipmentMonitor.Core\EquipmentMonitor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Hardware\Entities\" />
  </ItemGroup>

  <ItemGroup>
    <!-- 默认轴控配置：复制到输出目录，AxisFrameworkBootstrapper 默认从这里读取。 -->
    <None Update="Configuration\axis-framework.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>